      "source": [
        "estado = input(\"Qual é o estado onde o produto foi produzido? \").upper() # Converte a entrada para maiúsculas\n",
        "valor_produto = float(input(\"Qual o valor do produto? \"))\n",
        "\n",
        "# A linha abaixo foi comentada pois é um erro de sintaxe e parece uma condição incompleta.\n",
        "# pedido minimo () == \"RJ\" and valor_produto > 5000.00\n",
        "\n",
        "tax_rate = 0.0 # Inicializa a taxa de imposto\n",
        "\n",
        "if estado == \"MG\":\n",
        "    tax_rate = 0.05\n",
        "elif estado == \"SP\":\n",
        "    tax_rate = 0.05\n",
        "elif estado == \"RJ\":\n",
        "    tax_rate = 0.15\n",
        "elif estado == \"MS\": # Condição corrigida para estar na mesma linha que 'elif'\n",
        "    tax_rate = 0.05\n",
        "\n",
        "imposto_valor = valor_produto * tax_rate # Calcula o valor do imposto\n",
        "total = valor_produto + imposto_valor # Calcula o valor total\n",
        "\n",
        "# Corrigindo a sintaxe do f-string e garantindo que o literal esteja fechado\n",
        "print(f\"Valor do imposto: R$ {imposto_valor:9.2f}\")\n",
        "print(f\"Valor total: R$ {total:9.2f}\")"
      ],
