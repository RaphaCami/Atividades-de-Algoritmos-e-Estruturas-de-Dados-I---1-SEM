        "from ast import NodeVisitor\n",
        "vendas = float(input('Total: R$'))\n",
        "anos_empresa = int(input('Anos: '))\n",
        "salario_base = 2000.00\n",
        "comissao = vendas * 0.0\n",
        "\n",
        "if (vendas > 10000) and (anos_empresa >= 1):\n",
        "    bonus = 500.00\n",
        "\n",
        "else:\n",
        "    bonus = 0.00\n",
        "\n",
        "novo_salario = salario_base + comissao + bonus\n",
        "\n",
        "print(f'O salario inicial é R$ {salario_base:9.2f}')\n",
        "print(f'O comissao é R$ {comissao:9.2f}')\n",
        "print(f'O bonus é R$ {bonus:9.2f}')\n",
        "print(f'O novo salario é R$ {novo_salario:9.2f}')"
      ],
      "metadata": {
